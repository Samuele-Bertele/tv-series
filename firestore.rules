rules_version = '2';

// Regole Firestore per TVTRACKER.
//
// COME APPLICARLE
//   firebase deploy --only firestore:rules
// oppure incollandole in Console Firebase > Firestore Database > Regole.
//
// PRECONDIZIONE
// In Console Firebase > Authentication > Sign-in method vanno abilitati i
// provider "Anonimo" e "Google": senza, i pulsanti della modale Account
// falliscono con auth/operation-not-allowed.
//
// COSA E' CAMBIATO IN QUESTA VERSIONE
// L'archivio condiviso /tvtracker/* non esiste piu'. Era leggibile e
// SCRIVIBILE senza autenticazione: chiunque conoscesse il project id (pubblico,
// sta in app.js) poteva sostituirne il contenuto, e l'app ci scriveva dentro la
// libreria privata di chi era appena uscito da un account. Ora, senza accesso,
// l'app lavora solo in locale e non tocca Firestore.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // LIBRERIA PERSONALE - l'unica cosa che l'app legge e scrive.
    // Un utente vede e modifica solo i propri tre documenti. L'elenco chiuso
    // di docId impedisce di usare il proprio ramo come spazio libero.
    // ------------------------------------------------------------------
    match /users/{userId}/tvtracker/{docId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId
                  && docId in ['shows', 'ratings', 'watchdata'];

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && docId in ['shows', 'ratings', 'watchdata']
                            && request.resource.data.keys().hasOnly(['data', 'ts', 'updatedAt']);

      // [NUOVO] Serve al pulsante "Elimina account e dati nel cloud". Senza,
      // l'utente non aveva modo di rimuovere i propri dati e gli account
      // anonimi lasciavano documenti orfani per sempre. Resta limitato ai
      // propri tre documenti.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Tutto il resto e' chiuso. Le collezioni /tvtracker e /public non sono piu'
    // lette ne' scritte da nessuna parte dell'app: se contengono ancora dei
    // documenti, si cancellano a mano dalla Console.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
