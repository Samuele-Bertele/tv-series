+/* ==================== VOTO PER STAGIONE ====================
+   Il selettore in cima alla modale voto: "Serie intera" o una stagione. I
+   cinque assi restano gli stessi, cambia solo dove finisce il risultato
+   (ratingsData[titolo] oppure ratingsData[titolo].seasons[n]). */
+.rating-scope {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+  margin-bottom: var(--space-5);
+  padding: 12px 14px;
+  background: var(--surface);
+  border: 1px solid var(--surface-border);
+  border-radius: var(--radius-sm);
+}
+.rating-scope-label {
+  font-size: var(--fs-xs);
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.8px;
+  color: var(--text-muted);
+  flex-shrink: 0;
+}
+/* --fs-lg e non meno: sotto i 16px Safari su iOS ingrandisce la pagina al
+   tocco, e nella PWA installata non si torna indietro. */
+.rating-scope select {
+  flex: 1;
+  min-width: 160px;
+  background: var(--input-bg);
+  border: 1px solid var(--input-border);
+  color: var(--text);
+  font-family: var(--font-body);
+  font-size: var(--fs-lg);
+  border-radius: var(--radius-sm);
+  padding: 8px 10px;
+  cursor: pointer;
+}
+.rating-scope select:focus { outline: none; border-color: var(--accent); }
+.rating-scope-note { flex: 1 1 100%; font-size: var(--fs-xs); color: var(--text-muted); line-height: 1.5; margin: 0; }
+
+/* Elenco dei voti per stagione, nel dettaglio voti e nel riepilogo stagioni. */
+.season-ratings { display: flex; flex-direction: column; gap: 7px; margin-top: var(--space-5); }
+.season-ratings-title {
+  font-size: var(--fs-xs);
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.8px;
+  color: var(--text-muted);
+  margin-bottom: 2px;
+}
+.season-rating-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 9px 12px;
+  background: var(--surface);
+  border: 1px solid var(--surface-border);
+  border-radius: var(--radius-sm);
+}
+/* La classe di fascia sta sulla riga e colora valore e barra via currentColor:
+   il nome deve restare del colore del testo, altrimenti "Stagione 1" diventa
+   arancione e si legge come un'etichetta d'errore. */
+.season-rating-name { flex: 1; min-width: 0; font-size: var(--fs-base); font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.season-rating-track { width: 90px; height: 4px; border-radius: 2px; background: var(--surface-strong); overflow: hidden; flex-shrink: 0; }
+/* display:block: e' uno <span>, e su un inline la larghezza non si applica —
+   la barra restava vuota a qualsiasi voto. */
+.season-rating-fill { display: block; height: 100%; border-radius: 2px; background: currentColor; }
+.season-rating-val {
+  font-family: var(--font-display);
+  font-weight: 700;
+  font-size: var(--fs-md);
+  min-width: 34px;
+  text-align: right;
+  flex-shrink: 0;
+}
+/* Stesse quattro soglie degli anelli sulle card: sotto 3 rosso scuro, sotto 6
+   rosso, sotto 8 arancio, poi verde. */
+.season-rating-good  { color: var(--rating-good); }
+.season-rating-mid   { color: var(--rating-mid); }
+.season-rating-bad   { color: var(--rating-bad); }
+.season-rating-awful { color: var(--rating-awful-text); }
+.season-rating-none  { color: var(--text-muted); font-family: var(--font-body); font-weight: 600; font-size: var(--fs-sm); }
+
+/* Pillola del voto dentro il riepilogo stagioni della scheda serie. */
+.season-item-rating {
+  font-family: var(--font-display);
+  font-weight: 700;
+  font-size: var(--fs-sm);
+  padding: 2px 9px;
+  border-radius: var(--radius-pill);
+  background: var(--surface-strong);
+  border: 1px solid var(--surface-border-strong);
+  margin-left: 10px;
+}
+.season-item-head { display: flex; align-items: center; min-width: 0; }
+.season-item-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
+.seasons-empty { text-align: center; color: var(--text-muted); padding: 20px; }
+.seasons-summary { margin: 0; padding: 0 28px 14px; font-size: var(--fs-sm); color: var(--text-muted); }
+.season-rate-btn {
+  background: var(--surface-strong);
+  border: 1px solid var(--surface-border-strong);
+  color: var(--text-muted);
+  border-radius: var(--radius-sm);
+  width: 30px; height: 30px;
+  display: flex; align-items: center; justify-content: center;
+  cursor: pointer;
+  flex-shrink: 0;
+  transition: var(--transition);
+}
+.season-rate-btn:hover { background: rgba(var(--accent-rgb), 0.16); border-color: rgba(var(--accent-rgb), 0.4); color: var(--accent-text); }
+
